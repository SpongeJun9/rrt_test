<?xml version="1.0"?>
<package format="3">
  <name>rag_rrt_backend_py</name>
  <version>0.7.0</version>
  <description>Python algorithm backend for the C++ RAG-RRT* ROS 2 gateway.</description>
  <maintainer email="maintainer@example.com">RAG-RRT Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rag_rrt_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

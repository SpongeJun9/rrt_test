Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/Map
      Name: Static map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 0.5
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Color Scheme: costmap
      Alpha: 0.35
      Draw Behind: false
      Use Timestamp: false
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Update Topic:
        Value: /global_costmap/costmap_updates
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Color Scheme: costmap
      Alpha: 0.65
      Draw Behind: false
      Use Timestamp: false
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Update Topic:
        Value: /local_costmap/costmap_updates
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Polygon
      Name: Global Footprint
      Enabled: true
      Alpha: 1
      Color: 255; 160; 0
      Topic:
        Value: /global_costmap/published_footprint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Polygon
      Name: Local Footprint
      Enabled: true
      Alpha: 1
      Color: 25; 255; 0
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: Robot TF
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Global PCD map
      Enabled: true
      Topic:
        Value: /relocalization/global_map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Color: 80; 150; 255
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Decay Time: 0
      Selectable: false
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Live registered scan
      Enabled: true
      Topic:
        Value: /registered_scan
        Depth: 2
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Color: 255; 200; 40
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Decay Time: 0
      Selectable: false
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Path
      Name: RAG single planned path
      Enabled: true
      Topic:
        Value: /rag_rrt/validation/reference_path
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color: 0; 255; 80
      Line Style: Billboards
      Line Width: 0.04
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /rag_rrt/goal_pose
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 35
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 1280
  Height: 900
